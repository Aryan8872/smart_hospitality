          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {/* Service 1: ASSESS */}
            <div className="bento-card rounded-3xl p-7 bg-[#0C1208]/80 border border-white/10 hover:border-[#6DB33F]/50 backdrop-blur-md transition-all flex flex-col justify-between group shadow-lg">
              <div>
                <span className="inline-block text-[11px] font-extrabold uppercase tracking-wider text-[#6DB33F] bg-[#6DB33F]/15 px-3 py-1 rounded-full mb-4">
